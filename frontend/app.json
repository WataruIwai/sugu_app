{
  "expo": {
    "name": "Sugu",
    "slug": "frontend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.sugu.ios",
      "buildNumber": "3",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.sugu.ios"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Sugu",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "開発中にMac上の開発サーバーへ接続するため、ローカルネットワークを使用します。",
        "NSBonjourServices": [
          "_expo._tcp",
          "_react-native-metro._tcp"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3360875744879199~5720036041",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "許可することで、より関連性の高い広告を表示できるようになります。"
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "d6250025-268b-4a36-a8b5-df2b6bb09100"
      }
    }
  }
}
